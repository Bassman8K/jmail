# ---------------------------------------------------------------------------
# JMail configuration.
#
# Copy to `.env` (./run.sh does this for you on first run) and fill in only the
# providers you actually want to use. JMail starts and is fully usable with this
# file left untouched: the demo mailbox works out of the box.
# ---------------------------------------------------------------------------

# ---- Database -------------------------------------------------------------
POSTGRES_DB=jmail
POSTGRES_USER=jmail
POSTGRES_PASSWORD=jmail_local_dev
POSTGRES_PORT=5432

# ---- Ports ----------------------------------------------------------------
BACKEND_PORT=8090
WEB_PORT=3000
ADMINER_PORT=8081

# ---- Security -------------------------------------------------------------
# Leave empty for local development and a random key is generated at startup
# (all sessions end when the server restarts). MUST be set to a stable, secret
# value of at least 32 bytes in production.
JMAIL_JWT_SECRET=

# Allows POST /api/v1/auth/demo, which signs you into a seeded mailbox without
# any OAuth credentials. Never enable this outside local development.
JMAIL_DEMO_ENABLED=true

JMAIL_WEB_ORIGIN=http://localhost:3000

# ---- Google sign-in -------------------------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
# Authorised redirect URI: http://localhost:8090/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Microsoft sign-in (personal, work and school accounts) ---------------
# portal.azure.com -> Entra ID -> App registrations
# Redirect URI: http://localhost:8090/api/v1/auth/microsoft/callback
# Delegated permissions: openid profile email offline_access Mail.ReadWrite Mail.Send
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ---- Apple sign-in --------------------------------------------------------
# developer.apple.com -> Certificates, Identifiers & Profiles -> Keys (Sign in with Apple)
# APPLE_CLIENT_ID is the Services ID, not the bundle ID.
# APPLE_PRIVATE_KEY is the contents of the .p8 file; keep the newlines as \n.
# Redirect URI: https://<public-host>/api/v1/auth/apple/callback  (Apple requires HTTPS)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
